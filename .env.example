# Database (Shared Turso instance with Health Check & Client Dashboard)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# AWeber (for application-submitted tag)
# Same credentials as client-dashboard — tokens are read from shared Turso DB
AWEBER_CLIENT_ID=your_aweber_client_id
AWEBER_CLIENT_SECRET=your_aweber_client_secret
AWEBER_ACCOUNT_ID=your_aweber_account_id
AWEBER_LIST_ID=your_aweber_list_id
